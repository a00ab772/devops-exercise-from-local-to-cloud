pipeline {
    agent any
    tools {
        maven "Maven 3.8.7"
        jdk "JDK-21"
    }

    stages {
        stage('Fetch code') {
            steps {
                git branch: 'main', url: 'https://github.com/a00ab772/devops-exercise-from-local-to-cloud.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn install -DskipTests'
            }
            post {
                success {
                    echo 'Now Archiving it...'
                    archiveArtifacts artifacts: '**/target/*.war'
                }
            }
        }

        stage('UNIT TEST') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Checkstyle Analysis') {
            steps {
                sh 'mvn checkstyle:checkstyle'
            }
        }

        stage('Sonar Code analysis') {
            environment {
                scannerHome = tool 'sonar8.1.0'
            }
            steps {
                withSonarQubeEnv('sonarserver') {
                    sh '''${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=vprofile \
                        -Dsonar.projectName=vprofile \
                        -Dsonar.projectVersion=1.0 \
                        -Dsonar.sources=src/ \
                        -Dsonar.java.binaries=target/classes \
                        -Dsonar.junit.reportsPath=target/surefire-reports \
                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                        -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml \
                        -Dsonar.exclusions="**/*.js,**/*.ts,**/*.css,**/*.html" \
                        -Dsonar.javascript.skip=true'''
                }
            }
        }

       stage("Quality Gate") {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build App Image') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'registry-app-image', variable: 'appRegistry')
                    ]) {
                        def imgTag = "${appRegistry}:${env.BUILD_NUMBER}"
                        docker.build(imgTag, "./docker/dockerfiles/app/multistage/")
                    }
                }
            }
        }

        stage('Upload App Image') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'registry-url', variable: 'registryUrl'),
                        string(credentialsId: 'registry-app-image', variable: 'appRegistry'),
                        aws(credentialsId: 'awscreds', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        docker.withRegistry("https://${registryUrl}", 'awscreds') {
                            def customImage = docker.image("${appRegistry}:${env.BUILD_NUMBER}")
                            customImage.push("${env.BUILD_NUMBER}")
                            customImage.push('latest')
                        }
                    }
                }
            }
        }
    }
}