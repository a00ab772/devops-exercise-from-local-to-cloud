pipeline {
    agent any
    tools {
        maven "Maven 3.8.7"
        jdk "JDK-21"
    }

    environment {
        // registryCredential = 'ecr:us-east-1:awscreds'
        registryCredential = credentials('awscreds')
        //  vprofileRegistry = "https://716657688884.dkr.ecr.us-east-1.amazonaws.com"
        vprofileRegistry = credentials('vprofile-registry-url')
        // imageName = "716657688884.dkr.ecr.us-east-1.amazonaws.com/vprofileappimg"
        imageName = credentials('vprofile-image-name')
    }

    stages {
        stage('Fetch code') {
            steps {
                git branch: 'main', url: 'https://github.com/a00ab772/devops-exercise-from-local-to-cloud.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn install -DskipTests'
            }
            post {
                success {
                    echo 'Now Archiving it...'
                    archiveArtifacts artifacts: '**/target/*.war'
                }
            }
        }

        stage('UNIT TEST') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Checkstyle Analysis') {
            steps {
                sh 'mvn checkstyle:checkstyle'
            }
        }

        stage('Sonar Code analysis') {
            environment {
                scannerHome = tool 'sonar8.1.0'
            }
            steps {
                withSonarQubeEnv('sonarserver') {
                    sh '''${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=vprofile \
                        -Dsonar.projectName=vprofile \
                        -Dsonar.projectVersion=1.0 \
                        -Dsonar.sources=src/ \
                        -Dsonar.java.binaries=target/classes \
                        -Dsonar.junit.reportsPath=target/surefire-reports \
                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                        -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml \
                        -Dsonar.exclusions="**/*.js,**/*.ts,**/*.css,**/*.html" \
                        -Dsonar.javascript.skip=true'''
                }
            }
        }

       stage("Quality Gate") {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    // Parameter indicates whether to set pipeline to UNSTABLE if Quality Gate fails
                    // true = set pipeline to UNSTABLE, false = don't
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build App Image') {
          steps {

            script {
                dockerImage = docker.build( appRegistry + ":$BUILD_NUMBER", "./docker/dockerfiles/app/multistage/")
                }
          }

        }

        stage('Upload App Image') {
          steps{
            script {
              docker.withRegistry( vprofileRegistry, registryCredential ) {
                dockerImage.push("$BUILD_NUMBER")
                dockerImage.push('latest')
              }
            }
          }
        }

    }
}